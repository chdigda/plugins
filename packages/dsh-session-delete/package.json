{
  "name": "dsh-session-delete",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Confirmed permanent session deletion on the next DSH restart",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./boot": "./boot.mjs",
    "./package.json": "./package.json",
    "./client": "./client.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --test test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chdigda/plugins.git",
    "directory": "packages/dsh-session-delete"
  },
  "homepage": "https://github.com/chdigda/plugins/tree/main/packages/dsh-session-delete",
  "bugs": {
    "url": "https://github.com/chdigda/plugins/issues"
  },
  "files": [
    "index.mjs",
    "boot.mjs",
    "runtime.mjs",
    "core.mjs",
    "requests.mjs",
    "purge.mjs",
    "client.mjs",
    "cordis.patch.yml"
  ]
}

{
  "name": "dsh-session-tweak",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Inline user and assistant message editing through direct session JSON rewriting",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chdigda/plugins.git",
    "directory": "packages/dsh-session-tweak"
  },
  "homepage": "https://github.com/chdigda/plugins/tree/main/packages/dsh-session-tweak",
  "bugs": {
    "url": "https://github.com/chdigda/plugins/issues"
  },
  "files": [
    "index.mjs",
    "lifecycle.mjs",
    "runtime.mjs",
    "rewrite.mjs",
    "client.mjs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ]
}
